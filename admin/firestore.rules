rules_version = '2';

// ============================================================
//  Lucky Star Bonus Site — Firestore Security Rules
//  (ADMIN PANEL WITHOUT LOGIN — open access mode)
// ============================================================
//  Paste karein: Firebase Console → Firestore → Rules → Publish
//
//  NOTE: Admin panel me login nahi hai, isliye rules bhi open
//  rakhe gaye hain. Koi bhi jiska URL pata ho wo data
//  dekh / badal sakta hai. Agar future me login add karna ho
//  to neeche commented version use karein.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- submissions ----------
    // Bonus form bhi create karta hai, admin panel read/update/delete
    match /submissions/{docId} {
      allow read, write: if true;
    }

    // ---------- config ----------
    // Bonus plans: site padhta hai, admin likhta hai
    match /config/{docId} {
      allow read, write: if true;
    }

    // ---------- default ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


rules_version = '2';

// ============================================================
//  Lucky Star Bonus Site — Firestore Security Rules
// ============================================================
//  Paste karein: Firebase Console → Firestore → Rules → Publish
//
//  Admin email list me apni email add karein.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function adminEmails() {
      return [
        'admin@gmail.com'      // <-- apni email yahan change karein
      ];
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in adminEmails();
    }

    // ---------- submissions ----------
    // Bonus form (site) CREATE karta hai, admin padhta + update karta hai
    match /submissions/{docId} {

      // Site form se naya record add ho sakta hai
      allow create: if true;

      // Sirf admin padh sakta hai
      allow read: if isAdmin();

      // Sirf admin status change / delete kar sakta hai
      allow update, delete: if isAdmin();
    }

    // ---------- config ----------
    // Bonus plans: site ko READ chahiye, admin ko write
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- default: sab band ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
